<tr class="treegrid-controls">
  <%= tag.td colspan: do %>
    <button type="button" class="btn btn-link p-0" data-action="sdr-treegrid#expandAll">Expand all</button>
    <span aria-hidden="true">|</span>
    <button type="button" class="btn btn-link p-0" data-action="sdr-treegrid#collapseAll">Collapse all</button>
  <% end %>
</tr>
